<!DOCTYPE html>
<html lang="en">
{% #component "page_head" tailwind_plugins="typography" icon="🏢" %}
  {% #slot "extra" %}
    {% use_style "notes/css/theme.css" %}
    {% if tenant_stylesheet %}{% use_style tenant_stylesheet %}{% endif %}
  {% /slot %}
{% /component %}
<body class="min-h-screen flex flex-col" style="{{ tenant_theme_css }}">
  <div class="accent-bar h-1 w-full"></div>
  {% component "header" %}

  <main class="flex flex-1 flex-col">
    {% #component "container" extra="flex-1 py-8" %}
      {% template %}
    {% /component %}
  </main>

  {% component "footer" %}
  {% collect_scripts %}
</body>
</html>
