<header class="flex items-baseline justify-between">
  <h1 class="text-2xl font-semibold">All products</h1>
  {% zone "catalog-count" %}
    <p class="text-sm text-muted-foreground">{{ total }} products</p>
  {% endzone %}
</header>

{% form "preset_filter_form" zone=filter_zones %}
  <div class="flex flex-wrap gap-2" data-preset-bar>
    <button type="submit" name="preset" value="in_stock"
            class="rounded-full border border-border bg-background px-3 py-1 text-xs font-medium hover:bg-accent">
      In stock
    </button>
    <button type="submit" name="preset" value="cheapest"
            class="rounded-full border border-border bg-background px-3 py-1 text-xs font-medium hover:bg-accent">
      Cheapest first
    </button>
    <button type="submit" name="preset" value="newest"
            class="rounded-full border border-border bg-background px-3 py-1 text-xs font-medium hover:bg-accent">
      Newest
    </button>
  </div>
{% endform %}

{% more zone="catalog-results" previous=products %}
  <span class="block rounded-md border border-dashed border-border px-3 py-2 text-center text-sm text-muted-foreground hover:bg-accent">
    Show earlier results
  </span>
{% endmore %}

{% zone "catalog-results" tag="ul" %}
  {% for product in products %}
    <li data-next-key="{{ product.pk }}">{% component "product_card" %}</li>
  {% endfor %}
{% endzone %}

{% more zone="catalog-results" next=products prune=120 url="replace" %}
  <span class="block rounded-md border border-dashed border-border px-3 py-2 text-center text-sm text-muted-foreground hover:bg-accent">
    Show more
  </span>
{% empty %}
  <p data-catalog-end
     class="block rounded-md border border-dashed border-border px-3 py-2 text-center text-sm text-muted-foreground">
    End of results.
  </p>
{% endmore %}
