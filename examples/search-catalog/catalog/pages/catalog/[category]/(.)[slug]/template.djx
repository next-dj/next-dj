{% zone "product-peek" %}
<div data-product-peek class="w-full max-w-[28rem] space-y-3">
  <h2 class="text-xl font-semibold text-foreground">{{ peek.name }}</h2>
  <p class="text-sm text-muted-foreground">{{ peek.brand }}</p>
  <p class="text-2xl font-semibold">${{ peek.price }}</p>
  <p>
    {% if peek.in_stock %}
      {% component "badge" variant="success" text="In stock" %}
    {% else %}
      {% component "badge" variant="destructive" text="Out of stock" %}
    {% endif %}
  </p>
  {% if peek.description %}
    <p class="text-sm text-foreground">{{ peek.description }}</p>
  {% endif %}
  <p class="text-right">
    <a href="{{ request.path }}" class="text-sm font-medium text-primary hover:underline">Open the product page</a>
  </p>
</div>
{% endzone %}
