{% load catalog_qs %}
<nav class="flex items-center justify-between text-sm">
  {% if page_obj.has_previous %}
    <a class="rounded-md border border-border bg-background px-3 py-1 hover:bg-accent"
       href="?{% querystring page=page_obj.previous_page_number %}">Previous</a>
  {% else %}
    <span></span>
  {% endif %}
  <span class="text-muted-foreground">Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
  {% if page_obj.has_next %}
    <a class="rounded-md border border-border bg-background px-3 py-1 hover:bg-accent"
       href="?{% querystring page=page_obj.next_page_number %}">Next</a>
  {% else %}
    <span></span>
  {% endif %}
</nav>
