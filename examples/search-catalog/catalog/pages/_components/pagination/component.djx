{% load catalog_qs %}
<nav class="flex items-center justify-between text-sm">
  {% if products.previous %}
    <a class="rounded-md border border-border bg-background px-3 py-1 hover:bg-accent"
       href="?{% querystring page=products.previous %}">Previous</a>
  {% else %}
    <span></span>
  {% endif %}
  <span class="text-muted-foreground">{{ position }}</span>
  {% if products.next %}
    <a class="rounded-md border border-border bg-background px-3 py-1 hover:bg-accent"
       href="?{% querystring page=products.next %}">Next</a>
  {% else %}
    <span></span>
  {% endif %}
</nav>
