<!DOCTYPE html>
<html lang="en">
{% component "page_head" %}
<body class="min-h-screen flex flex-col">
  {% #component "app_shell" brand="🗳️ next.dj Live polls" brand_href="/polls/" %}
    {% #slot "actions" %}
      {% zone "open-polls" tag="span" class="text-sm text-muted-foreground" %}
        {{ active_polls_count }} open polls
      {% endzone %}
    {% /slot %}
    {% #slot "content" %}
      {% template %}
    {% /slot %}
  {% /component %}
  {% collect_scripts %}
</body>
</html>
