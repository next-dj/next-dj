<div class="space-y-6">
  <header class="flex items-baseline justify-between gap-4">
    <div>
      <a href="/polls/" class="text-xs uppercase tracking-wide text-muted-foreground hover:text-foreground">
        ← All polls
      </a>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-foreground">
        {{ poll.question }}
      </h1>
    </div>
    <div class="shrink-0 text-right text-xs uppercase tracking-wide text-muted-foreground">
      <p>Poll #{{ poll.pk }}</p>
      <a href="/polls/{{ poll.pk }}/embed/" data-next-layer="embed-code" class="hover:text-foreground">Embed</a>
    </div>
  </header>

  {% template %}
</div>
