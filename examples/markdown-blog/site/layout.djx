<!DOCTYPE html>
<html lang="en">
{% component "page_head" tailwind_plugins="typography" %}
<body class="min-h-screen flex flex-col">
  {% #component "app_shell" brand="next.dj blog" brand_href="/" brand_icon="✒️" %}
    {% #slot "nav" %}
      {% component "nav_link" url_name="next:page_" label="Home" variant="bar" %}
      {% component "nav_link" url_name="next:page_about" label="About" variant="bar" %}
    {% /slot %}
    {% #slot "content" %}
      {% zone "tagline" tag="p" class="-mt-4 mb-6 text-sm text-muted-foreground" %}{{ site_tagline }}{% endzone %}
      {% template %}
    {% /slot %}
    {% #slot "page_footer" %}
      {% zone "site-footer" %}
        {% component "site_footer" %}
      {% endzone %}
    {% /slot %}
  {% /component %}
  {% collect_scripts %}
</body>
</html>
