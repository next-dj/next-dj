<div class="space-y-6">
  {% #component "page_header" title=form_state.title description=form_state.verbose_name %}
    {% if form_state.is_change or form_state.in_layer %}
      {% #slot "actions" %}
        {% if form_state.in_layer %}
          {# Sibling of the edit form, not nested. {% form %} stamps data-next-action so the client intercepts the submit and dismisses the layer instead of navigating. #}
          {% form "admin:discard" class="inline" %}
            {% component "button" type="submit" text="Discard" variant="ghost" %}
          {% endform %}
        {% endif %}
        {% if form_state.is_change %}
          {% component "button" href=form_state.delete_url text="Delete" variant="outline" %}
        {% endif %}
      {% /slot %}
    {% endif %}
  {% /component %}

  {% form form_state.action_name %}
    <div class="space-y-4">
      {% if form_state.form_spec.non_field_errors %}
        {% #component "alert" variant="destructive" %}
          {% #slot "content" %}
            <ul>{% for err in form_state.form_spec.non_field_errors %}<li>{{ err }}</li>{% endfor %}</ul>
          {% /slot %}
        {% /component %}
      {% endif %}

      <div class="space-y-4">
        {% for section in form_state.form_spec.sections %}
          {% component "form_section" section=section %}
        {% endfor %}
        {% for block in form_state.inlines %}
          {% component "inline_formset" block=block %}
        {% endfor %}
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        {% component "button" href=form_state.changelist_url text="Cancel" variant="outline" %}
        {% component "button" type="submit" name="_save_addanother" text="Save and add another" variant="outline" %}
        {% component "button" type="submit" name="_save_continue" text="Save and continue editing" variant="outline" %}
        {% component "button" type="submit" text="Save" variant="default" %}
      </div>
    </div>
  {% endform %}

  {% for section in form_state.related_sections %}
    {% component "inline_live" section=section %}
  {% endfor %}
</div>
