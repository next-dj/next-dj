{% zone "receipt-peek" %}
<article class="w-full max-w-[32rem] space-y-4" data-receipt-peek>
  <header class="flex items-start justify-between gap-4">
    <h2 class="text-lg font-semibold tracking-tight">Receipt for request #{{ access_request.pk }}</h2>
    <form method="dialog">
      <button type="submit" aria-label="Close"
              class="rounded-md p-1 text-muted-foreground hover:bg-accent hover:text-accent-foreground">✕</button>
    </form>
  </header>
  <dl class="grid grid-cols-[7rem_1fr] gap-x-4 gap-y-1 text-sm">
    {% for label, value in receipt %}
      <dt class="text-muted-foreground">{{ label }}</dt><dd class="whitespace-pre-line">{{ value }}</dd>
    {% endfor %}
  </dl>
  <footer class="flex justify-end gap-4 text-sm font-medium">
    <a href="{% url 'next:page_request_int_access_request_receipt' access_request=access_request.pk %}?format=txt"
       class="underline hover:text-foreground">Download as text</a>
    <a href="{% url 'next:page_request_int_access_request_receipt' access_request=access_request.pk %}"
       class="underline hover:text-foreground">Open full receipt</a>
  </footer>
</article>
{% endzone %}
