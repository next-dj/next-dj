<div class="space-y-6">
  {% if moved_card %}
    {% component "preview" %}
  {% endif %}
  {% zone "board" %}
    <div id="kanban-board" data-next-keep class="flex gap-4 overflow-x-auto pb-4">
      {% for column in columns %}
        {% component "column" %}
      {% endfor %}
    </div>
  {% endzone %}
  <div data-next-stream="/board/{{ board_object.pk }}/stream/" hidden></div>
</div>
