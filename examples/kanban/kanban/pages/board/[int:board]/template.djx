<div class="space-y-6">
  {% if moved_card %}
    {% component "preview" %}
  {% endif %}
  <div id="kanban-board" class="flex gap-4 overflow-x-auto pb-4">
    {# React replaces this on mount, and it is the whole board without JS. #}
    {% for column in columns %}
      {% component "column" %}
    {% endfor %}
  </div>
</div>
