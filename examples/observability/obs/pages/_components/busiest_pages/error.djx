{% #component "alert" variant="warning" title="The busiest pages are unavailable" %}
  {% #slot "content" %}
    <p>The widget's own request did not come back with its list. Every other panel stays live.</p>
    {% if error.retry %}
      <button type="button" data-next-retry class="mt-2 rounded-md border border-border bg-background px-3 py-1 text-foreground hover:bg-accent">Try again</button>
    {% endif %}
  {% /slot %}
{% /component %}
