<h2 class="mb-4 text-lg font-semibold">Per-page render counts</h2>
{% if rows %}
  <table class="w-full text-sm" data-page-renders>
    <thead class="text-left text-muted-foreground">
      <tr>
        <th class="py-2 pr-4">Page module</th>
        <th class="py-2 pl-4 text-right">Renders</th>
        <th class="py-2 pl-4 text-right">Mean ms</th>
      </tr>
    </thead>
    <tbody>
      {% for module, count, mean in rows %}
        <tr class="border-t border-border">
          <td class="py-2 pr-4 font-mono text-xs">{{ module }}</td>
          <td class="py-2 pl-4 text-right tabular-nums">{{ count }}</td>
          <td class="py-2 pl-4 text-right tabular-nums">{{ mean|default_if_none:"&mdash;" }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <p class="text-sm text-muted-foreground">No pages have been rendered yet. Visit a few dashboards and reload.</p>
{% endif %}
