<!DOCTYPE html>
<html lang="en">
{% component "page_head" title="next.dj — Observability dashboard" icon="📊" %}
<body class="min-h-screen flex flex-col">
  {% #component "app_shell" brand="next.dj observability" brand_href="/" brand_icon="📊" %}
    {% #slot "actions" %}
      {% component "nav_link" url="/" label="Overview" variant="bar" %}
      {% component "nav_link" url="/stats/" label="Stats" variant="bar" %}
    {% /slot %}
    {% #slot "content" %}
      {% template %}
    {% /slot %}
  {% /component %}
  {% collect_scripts %}
</body>
</html>
