<h1>zoned page</h1>
{% zone "alpha" %}<p>alpha {{ greeting }}</p>{% endzone %}
{% zone "beta" tag="section" %}<p>beta {{ greeting }}</p>{% endzone %}
{% zone "later" reload="loading" delay="300ms" %}<p>later {{ greeting }}</p>{% endzone %}
{% zone "ticker" poll="5s" %}<p>tick {{ greeting }}</p>{% endzone %}
